# ── Adobe Stock — Images Generator by agents · API ────────────────────────
# Copy to .env (local) or set in Render dashboard (production).

# HTTP port (Render sets it automatically)
PORT=3333

# MongoDB (Atlas M0 is fine). Required — the API refuses to start without it in production.
# The URI can be a bare cluster link (no db name needed in the path).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name, SEPARATE from the URI — set it here if you need a specific db.
# Optional: if empty, the db found in the URI path is used, else the default "adobe-stock".
# (MONGODB_DB_NAME is accepted as an alias.)
MONGO_DB_NAME=adobe-stock

# Credential for the AI agent (header: X-API-Key). Generate: openssl rand -hex 24
API_KEY=change-me-agent-key

# Password for the Next.js web app (header: X-App-Password). Typed at the app gate.
APP_PASSWORD=change-me-webapp-password

# Allowed browser origins for the web app (comma separated), or * for any.
# Set this to your Netlify URL, e.g. https://stockroom.netlify.app
CORS_ORIGINS=*

# Render sits behind a proxy — keep 1 in production, 0 for local tests.
TRUST_PROXY=1

# Rate limits (windows in ms, counts per IP)
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_BAD_AUTH_MAX=30
RATE_LIMIT_BAD_AUTH_BLOCK_MS=600000

# Download proxy timeout for image_link fetches
DOWNLOAD_TIMEOUT_MS=25000

# ── Upscales (Real-ESRGAN via GitHub Actions) ────────────────────────────
# Default server-side policy: how many upscale entries an image may hold.
# The GitHub Actions job passes its own max_upscales (repo secret
# MAX_NUMBER_OF_UPSCALES_PER_IMAGE) in the POST body — it applies when lower.
# Hard ceiling enforced by the code: 10.
MAX_UPSCALES_PER_IMAGE=10

# Cloudinary (OPTIONAL — only used to destroy the remote asset when an
# upscale entry is deleted from the webapp; the uploads themselves happen on
# the GitHub Actions runner, with its own repo secrets). Leave empty to make
# deletion purely database-level.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
